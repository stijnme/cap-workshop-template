{
  "name": "cap-workshop-template",
  "version": "1.0.0",
  "description": "Workshop template: CAP 10 TypeScript hello world with all quality gates pre-wired",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "PORT=4005 cds serve",
    "watch": "PORT=4005 cds watch",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=test/.env --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/cds-types": "^0.19.0",
    "@sap/cds-dk": "^10",
    "@types/node": "^22",
    "oxlint": "^1",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^5.9"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "messaging": {
        "kind": "file-based-messaging",
        "[test]": {
          "kind": "local-messaging"
        }
      }
    }
  }
}
